# Leave empty in development: the Vite dev server proxies /api and /uploads to http://localhost:8080.
# Set only when the API lives on another origin in a deployed build.
VITE_API_BASE_URL=
# Where shared question and story links point (the backend's link-preview pages). Empty: this site's own /share,
# which the host must proxy to the API like /api. Or the API's address, e.g. https://api.agrotrends.com
VITE_SHARE_BASE_URL=
